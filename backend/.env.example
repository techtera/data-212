# =============================================================================
# TERAFAC Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# --- Database (Neon Postgres) ---
# Get free DB at https://neon.tech — create a project, copy connection string
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/terafac?sslmode=require

# --- Google Cloud Storage ---
# Create a GCS bucket and service account with Storage Admin role
# Download the JSON key file and place it in backend/ folder
GCS_BUCKET_NAME=terafac-datasets
GCS_SA_KEY_PATH=gcs-service-account.json
# For Render deployment: paste the entire JSON content instead of file path
# GCS_SA_KEY_PATH={"type":"service_account","project_id":"...","private_key":"..."}

# --- Training VM (GCP) ---
# A GCP VM with GPU for running training/inference
VM_HOST=34.100.200.50
VM_USER=your_vm_username
VM_SSH_KEY_PATH=keys/gcp-vm-key-ed25519
# For Render deployment: paste the full private key content including headers
# VM_SSH_KEY_PATH=-----BEGIN OPENSSH PRIVATE KEY-----\nb3Blbn...\n-----END OPENSSH PRIVATE KEY-----

# Training mode: "stub" = fake results (no VM needed), "ssh" = real GPU training
TRAINING_MODE=stub

# --- Gemini API (AI Research + Coding Agents) ---
# Get free API key at https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# --- Auth ---
BCRYPT_ROUNDS=12
SESSION_TTL_HOURS=24
