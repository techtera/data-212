# =============================================================================
# TERAFAC Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# --- Database (Neon Postgres) ---
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/terafac?sslmode=require

# --- Google Cloud Storage ---
GCS_BUCKET_NAME=terafac-datasets
GCS_SA_KEY_PATH=gcs-service-account.json
GCS_SIGNED_URL_TTL=900

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# --- Training VM (GCP) ---
VM_HOST=34.xxx.xxx.xxx
VM_USER=ubuntu
VM_SSH_KEY_PATH=/path/to/ssh/private_key
# Set to "stub" for local dev (no real VM needed), "ssh" for production
TRAINING_MODE=stub

# --- Auth ---
BCRYPT_ROUNDS=12
SESSION_TTL_HOURS=24
