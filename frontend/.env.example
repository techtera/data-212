# =============================================================================
# TERAFAC Frontend - Environment Variables
# =============================================================================
# Copy this file to .env.local and set your backend URL.
# NEVER commit .env.local to source control.

# Backend API URL
# For local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# For deployed backend (Render):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# For LAN access (use your machine's IP):
# NEXT_PUBLIC_API_URL=http://192.168.x.x:8000
