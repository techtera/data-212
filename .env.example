# TERAFAC Backend — environment variables template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Static admin token for Phase 1 (hardcoded auth).
# FE sends:  Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=dev-token-change-me

# Username + password accepted by POST /auth/login  (Phase 1 hardcoded check)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_PROJECT_ID=terafac-dev
# Optional: path to a GCP service-account JSON key.
# Omit to use Application Default Credentials (gcloud auth application-default login).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
