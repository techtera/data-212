# TERAFAC Backend — environment variables template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to the GCP service-account JSON key file.
# Omit or leave blank to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id

# ── Auth — V1 legacy (dev-token fallback) ────────────────────────────────────
# Static admin token for Phase 1 (hardcoded auth). Only used when ALLOW_DEV_TOKEN=true.
ADMIN_TOKEN=dev-token-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── Auth — V2: session-based auth ────────────────────────────────────────────
# bcrypt work factor (minimum 12 for production)
BCRYPT_ROUNDS=12
# Session cookie lifetime in hours
SESSION_TTL_HOURS=24
# Allow the V1 dev-token? MUST be false in production.
ALLOW_DEV_TOKEN=false
# Max login attempts per IP per minute
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Max jobs a single user can create per day
MAX_JOBS_PER_USER_PER_DAY=20

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
