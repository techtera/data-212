# TERAFAC Backend — environment variables template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Firebase / Firestore ──────────────────────────────────────────────────────
# Path to the GCP service-account JSON key file.
# Omit or leave blank to use Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id

# ── Auth — V1 legacy (dev-token fallback) ────────────────────────────────────
# Static admin token for Phase 1 (hardcoded auth). Only used when ALLOW_DEV_TOKEN=true.
ADMIN_TOKEN=dev-token-change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ── Auth — V2: session-based auth ────────────────────────────────────────────
# bcrypt work factor (minimum 12 for production)
BCRYPT_ROUNDS=12
# Session cookie lifetime in hours
SESSION_TTL_HOURS=24
# Allow the V1 dev-token? MUST be false in production.
ALLOW_DEV_TOKEN=false
# Max login attempts per IP per minute
RATE_LIMIT_LOGIN_PER_MINUTE=5
# Max jobs a single user can create per day
MAX_JOBS_PER_USER_PER_DAY=20

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# ── V3: JWT hop tokens ────────────────────────────────────────────────────────
# Minimum 32 characters. Used to sign short-lived JWTs for worker tasks.
# MUST be set in production. Missing or too short = server refuses to start.
JWT_HOP_SECRET=change-me-in-production-minimum-32-chars-here
JWT_HOP_ISSUER=terafac-api
JWT_HOP_AUDIENCE=terafac-worker
JWT_HOP_TTL_SECONDS=300

# ── V4: Research agent ────────────────────────────────────────────────────────
# URL of the Cloud Run research agent container. In dev, leave as localhost stub.
RESEARCH_AGENT_URL=http://localhost:8001/run
# Gemini API key — loaded from Secret Manager in production. Empty = stub mode.
GEMINI_API_KEY=
# Max seconds to wait for research agent response
RESEARCH_TIMEOUT_SECONDS=60

# ── V4-GCS: Google Cloud Storage ─────────────────────────────────────────────
# Bucket name — SA has roles/storage.objectAdmin on THIS bucket only.
GCS_BUCKET_NAME=terafac-datasets
# Max TTL for signed URLs in seconds (15 min). NEVER exceed 900.
GCS_SIGNED_URL_TTL_SECONDS=900
# Path to the GCS service-account JSON key for signing URLs.
# This file is gitignored. NEVER read/print/log its contents.
# In production, use Workload Identity and omit this.
GCS_SA_KEY_PATH=gcs-service-account.json

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
